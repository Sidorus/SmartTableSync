# Azure Functions local settings — contains secrets, never commit
local.settings.json

# Build output
bin/
obj/

# Visual Studio
.vs/
*.user

# Rider
.idea/

# Publish profiles and deployment artifacts — contain Azure resource names / subscription IDs
**/Properties/

# Markdown docs — keep only the public-facing READMEs, user guides in docs/ and the ADRs out of
# the ignore list
*.md
!README.md
!docs/*.md
!docs/adr/*.md

# Terraform (demo) - state holds resource IDs and the lock file is created by terraform init
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan

# SQL the demo script generates with SmartTableSync.Scaffold
demo/generated/
