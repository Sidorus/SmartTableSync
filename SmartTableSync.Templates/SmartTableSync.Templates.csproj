<Project Sdk="Microsoft.NET.Sdk">

  <!-- The dotnet new template "smarttablesync-azure": the Azure Function and the quick start
       (deploy.ps1 and its Terraform) as a project of your own that uses the NuGet packages.
       The files come from SmartTableSyncFunction/ and quickstart/ as they are when packing, so
       there is only one copy of them. Only the project file differs: it references the
       SmartTableSync package, with this package's version, instead of SmartTableSync.Core. -->

  <PropertyGroup>
    <PackageId>SmartTableSync.Templates</PackageId>
    <PackageType>Template</PackageType>
    <!-- Local default only. A release takes its version from the git tag (v0.5.0 -> 0.5.0);
         see .github/workflows/publish.yml and docs/releasing.md. -->
    <Version>0.0.0-dev</Version>
    <!-- A release sets PackageReleaseNotes to the version's changelog section (an environment
         variable in publish.yml); otherwise the package links to the changelog. -->
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">What changed in each version: https://github.com/Sidorus/SmartTableSync/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Authors>Ruslan Sidoriako</Authors>
    <Description>dotnet new template for SmartTableSync: an Azure Function that syncs tables from a parent to a child Azure SQL database, with a script and Terraform that deploy it and start the first sync. Install with "dotnet new install SmartTableSync.Templates", then create a project with "dotnet new smarttablesync-azure".</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sidorus/SmartTableSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sidorus/SmartTableSync</RepositoryUrl>
    <PackageTags>sql;azure;azure-sql;data-sync;sync;azure-functions;terraform;dotnet-new;template</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Only files: no code of its own, no dependencies, no lib folder -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5128: no lib folder. NU5110/NU5111: deploy.ps1 is a file of the template, not a
         NuGet install script. -->
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>

    <TemplateRoot>content/smarttablesync-azure/</TemplateRoot>
    <VersionedFilesDir>$(BaseIntermediateOutputPath)template-files/</VersionedFilesDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The template's own files: template.json, .gitignore, the project's README -->
    <Content Include="template\**\*" Exclude="template\**\*.template" PackagePath="$(TemplateRoot)%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- The Function, from the repository -->
    <Content Include="..\SmartTableSyncFunction\**\*.cs" Exclude="..\SmartTableSyncFunction\bin\**;..\SmartTableSyncFunction\obj\**" PackagePath="$(TemplateRoot)SmartTableSyncFunction/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\SmartTableSyncFunction\host.json" PackagePath="$(TemplateRoot)SmartTableSyncFunction/host.json" />
    <Content Include="..\Directory.Build.props" PackagePath="$(TemplateRoot)Directory.Build.props" />

    <!-- The quick start, from the repository -->
    <Content Include="..\quickstart\deploy.ps1" PackagePath="$(TemplateRoot)quickstart/deploy.ps1" />
    <Content Include="..\quickstart\terraform\*.tf" PackagePath="$(TemplateRoot)quickstart/terraform/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The two files that carry the version: the Function's project file, with the SmartTableSync
       package instead of the project reference, and the local tool manifest for the scaffold tool.
       Both get this package's version, so a template always creates a project that uses the
       packages released with it. -->
  <Target Name="AddVersionedTemplateFiles" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_FunctionProject>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\SmartTableSyncFunction\SmartTableSyncFunction.csproj'))</_FunctionProject>
      <_ProjectReference>&lt;ProjectReference Include="..\SmartTableSync.Core\SmartTableSync.Core.csproj" /&gt;</_ProjectReference>
      <_PackageReference>&lt;PackageReference Include="SmartTableSync" Version="$(PackageVersion)" /&gt;</_PackageReference>
      <_TemplateProject>$(_FunctionProject.Replace('$(_ProjectReference)', '$(_PackageReference)'))</_TemplateProject>
      <_ToolManifest>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)template\.config\dotnet-tools.json.template').Replace('SMARTTABLESYNC_VERSION', '$(PackageVersion)'))</_ToolManifest>
    </PropertyGroup>

    <Error Condition="!$(_FunctionProject.Contains('$(_ProjectReference)'))" Text="SmartTableSyncFunction.csproj no longer has the line '$(_ProjectReference)' that the template replaces with the SmartTableSync package. Update the replacement in SmartTableSync.Templates.csproj." />

    <WriteLinesToFile File="$(VersionedFilesDir)SmartTableSyncFunction.csproj" Lines="$([MSBuild]::Escape($(_TemplateProject)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(VersionedFilesDir)dotnet-tools.json" Lines="$([MSBuild]::Escape($(_ToolManifest)))" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Content Include="$(VersionedFilesDir)SmartTableSyncFunction.csproj" Pack="true" PackagePath="$(TemplateRoot)SmartTableSyncFunction/SmartTableSyncFunction.csproj" />
      <Content Include="$(VersionedFilesDir)dotnet-tools.json" Pack="true" PackagePath="$(TemplateRoot).config/dotnet-tools.json" />
    </ItemGroup>
  </Target>

</Project>
