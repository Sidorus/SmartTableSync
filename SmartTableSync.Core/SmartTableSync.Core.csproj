<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SmartTableSync</PackageId>
    <Version>0.2.0</Version>
    <Authors>Ruslan Sidoriako</Authors>
    <Description>A self-configuring sync engine for SQL tables Azure SQL Data Sync can't handle — nvarchar(max)/varbinary(max) indexed keys, rows over Data Sync's 24 MB batch limit. Give it a table name; it introspects the schema, derives a sync plan, and generates reviewable SQL.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sidorus/SmartTableSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sidorus/SmartTableSync</RepositoryUrl>
    <PackageTags>sql;azure;azure-sql;data-sync;sync</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Direct reference only to lift Microsoft.Data.SqlClient's transitive dependency past a
         known vulnerability (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 in 9.0.13). Remove once
         SqlClient itself depends on a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
