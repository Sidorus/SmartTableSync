<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SmartTableSync</PackageId>
    <Version>0.3.0</Version>
    <Authors>Ruslan Sidoriako</Authors>
    <Description>A self-configuring sync engine for SQL tables Azure SQL Data Sync can't handle — nvarchar(max)/varbinary(max) indexed keys, rows over Data Sync's 24 MB batch limit. Give it a table name; it introspects the schema, derives a sync plan, and generates reviewable SQL.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sidorus/SmartTableSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sidorus/SmartTableSync</RepositoryUrl>
    <PackageTags>sql;azure;azure-sql;data-sync;sync</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The public API is only what a host calls, configures or replaces (AddSmartTableSync,
       SyncSettings, ISyncOrchestrator, ISyncRunLock, IDbConnectionFactory, ISyncMetricsReporter).
       Everything else is internal so it can change without breaking package users; the Scaffold
       CLI (same product) and the test projects use it directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SmartTableSync.Scaffold" />
    <InternalsVisibleTo Include="SmartTableSync.Tests" />
    <InternalsVisibleTo Include="SmartTableSync.IntegrationTests" />
  </ItemGroup>

</Project>
