<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" OutputItemType="Analyzer" />
    <!-- The SmartTableSync metrics go to Application Insights through OpenTelemetry; the logs go
         through the Functions host (see Program.cs). -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
  </ItemGroup>

  <!-- The SmartTableSync library brings the Microsoft Entra sign-in (Managed Identity) package
       with it. The smarttablesync-azure template (SmartTableSync.Templates) ships this project
       with the reference below replaced by the SmartTableSync NuGet package. -->

  <ItemGroup>
    <ProjectReference Include="..\SmartTableSync.Core\SmartTableSync.Core.csproj" />
  </ItemGroup>

</Project>
