<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartTableSync.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.13.0" />
    <!-- Lifts Testcontainers' transitive SSH.NET past GHSA-q939-rpr3-3284 / GHSA-mggc-4xg6-vcxf.
         Remove once Testcontainers depends on a fixed version. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartTableSync.Core\SmartTableSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schema\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SeedData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The documented least-privilege grants, run as written by LeastPrivilegeSyncTests -->
    <None Include="..\sql\07_permissions.sql" Link="sql\07_permissions.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>