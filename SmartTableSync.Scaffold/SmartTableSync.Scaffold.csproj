<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>smarttablesync-scaffold</ToolCommandName>
    <PackageId>SmartTableSync.Scaffold</PackageId>
    <!-- Local default only. A release takes its version from the git tag (v0.5.0 -> 0.5.0);
         see .github/workflows/publish.yml and docs/releasing.md. -->
    <Version>0.0.0-dev</Version>
    <!-- A release sets PackageReleaseNotes to the version's changelog section (an environment
         variable in publish.yml); otherwise the package links to the changelog. -->
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">What changed in each version: https://github.com/Sidorus/SmartTableSync/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Authors>Ruslan Sidoriako</Authors>
    <Description>Manual schema-scaffolding CLI for SmartTableSync - introspects a table (or generates the shared tracking infrastructure) and writes reviewable .sql files. Never executes anything against a database itself.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sidorus/SmartTableSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sidorus/SmartTableSync</RepositoryUrl>
    <PackageTags>sql;azure;azure-sql;data-sync;sync;cli;dotnet-tool</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Debuggable, verifiable package: the debug symbols inside the DLL, with Source Link to the
         exact commit on GitHub, and a deterministic build in GitHub Actions -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartTableSync.Core\SmartTableSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Concrete implementations (Core only references the *.Abstractions packages) - needed
         to build a real IConfiguration from environment variables so Scaffold can bind the
         same SyncSettings (ChangeTrackingColumns/AllowFullRescanFor/IncrementalStrategyOverrides)
         the runtime does, via SyncSettingsServiceCollectionExtensions.Bind. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <!-- Microsoft Entra sign-in (Active Directory Default and others) comes with SmartTableSync.Core -->
  </ItemGroup>

  <ItemGroup>
    <None Include="..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
