<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>smarttablesync-scaffold</ToolCommandName>
    <PackageId>SmartTableSync.Scaffold</PackageId>
    <!-- Local default only. A release takes its version from the git tag (v0.5.0 -> 0.5.0);
         see .github/workflows/publish.yml and docs/releasing.md. -->
    <Version>0.0.0-dev</Version>
    <PackageReleaseNotes>What changed in each version: https://github.com/Sidorus/SmartTableSync/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Authors>Ruslan Sidoriako</Authors>
    <Description>Manual schema-scaffolding CLI for SmartTableSync - introspects a table (or generates the shared tracking infrastructure) and writes reviewable .sql files. Never executes anything against a database itself.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sidorus/SmartTableSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sidorus/SmartTableSync</RepositoryUrl>
    <PackageTags>sql;azure;azure-sql;data-sync;sync;cli;dotnet-tool</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartTableSync.Core\SmartTableSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Concrete implementations (Core only references the *.Abstractions packages) - needed
         to build a real IConfiguration from environment variables so Scaffold can bind the
         same SyncSettings (ChangeTrackingColumns/AllowFullRescanFor/IncrementalStrategyOverrides)
         the runtime does, via SyncSettingsServiceCollectionExtensions.Bind. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <!-- Microsoft.Data.SqlClient 7.0 moved the "Authentication=Active Directory ..." providers
         out of the core package; needed to connect with an Entra identity. Keep the same
         version as the Microsoft.Data.SqlClient reference in SmartTableSync.Core. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
