<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SmartTableSync</PackageId>
    <!-- Local default only. A release takes its version from the git tag (v0.5.0 -> 0.5.0);
         see .github/workflows/publish.yml and docs/releasing.md. -->
    <Version>0.0.0-dev</Version>
    <!-- A release sets PackageReleaseNotes to the version's changelog section (an environment
         variable in publish.yml); otherwise the package links to the changelog. -->
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">What changed in each version: https://github.com/Sidorus/SmartTableSync/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Authors>Ruslan Sidoriako</Authors>
    <Description>A self-configuring sync engine for SQL tables Azure SQL Data Sync can't handle - nvarchar(max)/varbinary(max) indexed keys, rows over Data Sync's 24 MB batch limit. Give it a table name; it introspects the schema, derives a sync plan, and generates reviewable SQL.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sidorus/SmartTableSync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sidorus/SmartTableSync</RepositoryUrl>
    <PackageTags>sql;azure;azure-sql;data-sync;sync</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Debuggable, verifiable package: the debug symbols inside the DLL, with Source Link to the
         exact commit on GitHub, and a deterministic build in GitHub Actions -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Since SqlClient 7.0, every "Authentication=Active Directory ..." sign-in (managed identity,
         Entra users, service principals, workload identity) lives in this package. Included, so a
         host connects to Azure SQL with only the SmartTableSync package; keep it on the same version
         as Microsoft.Data.SqlClient above (Dependabot updates them together). -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <!-- Direct reference only to lift Microsoft.Data.SqlClient's transitive dependency past a
         known vulnerability (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 in 9.0.13). Remove once
         SqlClient itself depends on a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
  </ItemGroup>

  <!-- The package has its own README with absolute links: the repository README links to other
       files by relative paths, which don't resolve on nuget.org. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The public API is only what a host calls, configures or replaces (AddSmartTableSync,
       SyncSettings, ISyncOrchestrator, ISyncRunLock, IDbConnectionFactory, ISyncMetricsReporter).
       Everything else is internal so it can change without breaking package users; the Scaffold
       CLI (same product) and the test projects use it directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SmartTableSync.Scaffold" />
    <InternalsVisibleTo Include="SmartTableSync.Tests" />
    <InternalsVisibleTo Include="SmartTableSync.IntegrationTests" />
  </ItemGroup>

</Project>
